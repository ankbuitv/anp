<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AnpMobile.ViewModels"
             x:Class="AnpMobile.Pages.AlbumsPage"
             Title="Album">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Album mới" Clicked="CreateClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Albums}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumTileViewModel">
                        <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="140,*">
                                <Grid Grid.Row="0">
                                    <Image Source="{Binding CoverPath}" Aspect="AspectFill" />
                                    <Label Text="🎞" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Dark={StaticResource Mute}, Light={StaticResource MuteLight}}"
                                           IsVisible="{Binding ShowPlaceholder}" />
                                    <Button Text="⋯" BackgroundColor="#55000000" TextColor="White" FontSize="18"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                                            Clicked="TileMenuClicked" />
                                </Grid>
                                <VerticalStackLayout Grid.Row="1" Padding="12,8" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding CountText}" Style="{StaticResource LabelMuted}" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TileTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="32" VerticalOptions="Center" Spacing="10">
            <Label Text="Chưa có album" FontSize="18" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Dark={StaticResource Mute}, Light={StaticResource MuteLight}}" />
            <Label Text="Tạo album để gom ảnh/video theo chủ đề." Style="{StaticResource LabelMuted}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorText}" Style="{StaticResource LabelError}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
