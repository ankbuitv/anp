<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnpMobile.LoginPage"
             Title="Đăng nhập">
    <VerticalStackLayout Spacing="15" Padding="30">
        <Entry Placeholder="Email" x:Name="EmailEntry"/>
        <Entry Placeholder="Mật khẩu" IsPassword="True" x:Name="PasswordEntry"/>
        <Button Text="Đăng nhập" Clicked="LoginClicked"/>
    </VerticalStackLayout>
</ContentPage>
