# Sao chép thành .dev.vars (Wrangler) hoặc secrets trên Cloudflare.
# KHÔNG commit file chứa giá trị thật.
# D1 và Workers KV dùng binding trong wrangler.toml, không cần secret tại đây.

# URL công khai (dùng cho link chia sẻ / QR)
APP_URL=http://localhost:5173

# Tùy chọn
TURNSTILE_SECRET=
ENVIRONMENT=development
