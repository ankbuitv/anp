# Sao chép thành .dev.vars (Wrangler) hoặc secrets trên Cloudflare.
# KHÔNG commit file chứa giá trị thật.
# D1 và Workers KV dùng binding trong wrangler.toml, không cần secret tại đây.

# URL công khai (dùng cho link chia sẻ / QR)
APP_URL=http://localhost:5173

# Tùy chọn
TURNSTILE_SECRET=
ENVIRONMENT=development

# Email xác minh (production bắt buộc cấu hình một provider).
# Nhà phát triển local: mặc định EMAIL_PROVIDER=log để in link ra console wrangler.
EMAIL_PROVIDER=log
MAIL_FROM=ANP <no-reply@ankb.qzz.io>
RESEND_API_KEY=
BREVO_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
