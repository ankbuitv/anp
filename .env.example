# Sao chép thành .dev.vars (Wrangler) hoặc secrets trên Cloudflare.
# KHÔNG commit file chứa giá trị thật.

# Tùy chọn — dùng khi muốn signed URL S3-compatible tới R2
# (upload lớn trực tiếp, không đi qua Worker).
# Nếu bỏ trống, ANP dùng multipart qua R2 binding (hoạt động local + production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=anp-media

# URL công khai (dùng cho link chia sẻ / QR)
APP_URL=http://localhost:5173

# Tùy chọn
TURNSTILE_SECRET=
ENVIRONMENT=development
