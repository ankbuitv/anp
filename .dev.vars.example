# Sao chép thành .dev.vars chỉ khi muốn Wrangler local dùng Backblaze B2 thật.
# Nếu không khai báo đủ 4 giá trị B2_BUCKET/B2_ENDPOINT/B2_KEY_ID/B2_APP_KEY,
# Worker dùng MEDIA Workers KV local làm fallback.
#
# KHÔNG commit .dev.vars. KHÔNG dùng hoặc chia sẻ master application key.
# Trên Backblaze, hãy tạo Application Key con chỉ có List/Read/Write/Delete
# và giới hạn duy nhất bucket anp-media.

APP_URL=http://localhost:5173
ENVIRONMENT=development
EMAIL_PROVIDER=log

B2_BUCKET=anp-media
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=<bucket-scoped-application-key-id>
B2_APP_KEY=<bucket-scoped-application-key-secret>

# Tùy chọn khác
TURNSTILE_SECRET=
MAIL_FROM=ANP <no-reply@ankb.qzz.io>
RESEND_API_KEY=
BREVO_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
